# JWT Secret (mind. 32 Zeichen für Produktion)
JWT_SECRET=hydrobreak-dev-secret-change-in-production
# Server-Port
PORT=3001
# Optional: Ordner für JSON-Daten (Standard: server/data)
# DATA_DIR=./data

# Google OAuth (Web-Client-ID aus Google Cloud Console)
# Gleicher Wert im Frontend als VITE_GOOGLE_CLIENT_ID setzen.
# GOOGLE_CLIENT_ID=123456789-xxx.apps.googleusercontent.com

# Apple Sign In (Service-ID aus Apple Developer)
# APPLE_CLIENT_ID=de.example.hydrobreak
# APPLE_SERVICE_ID=de.example.hydrobreak  # falls abweichend

# E-Mail für Verifizierungscodes (optional; ohne SMTP wird der Code nur in die Konsole geloggt)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@example.com
# APP_NAME=HydroBreak

# Wochen-Digest (E-Mail Sonntag Abend): Cron-Ausdruck (Standard: Sonntag 20:00)
# Format: Minute Stunde Tag Monat Wochentag (0=Sonntag). Beispiele: 0 18 * * 0 = So 18:00, 0 21 * * 6 = Sa 21:00
# DIGEST_CRON=0 20 * * 0

# Web Push (Erinnerungen bei geschlossenem Tab) – optional
# Schlüssel einmal erzeugen: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_MAILTO=mailto:noreply@deine-domain.de
